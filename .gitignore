# worker logs and scratch never enter the repo
*.log
scratch/
.env
*.pat
*.key
# Any private environment file by extension, not just the dotfiles: examples/demo/README.md
# tells the operator to create demo.env, and it must never be committed.
*.env
!*.env.example
# Offline image-build input: wheels dropped here by the operator, never committed.
components/*/*/wheels/
# Generated local evidence, credentials and Python caches.
.env.*
!.env.example
__pycache__/
.pytest_cache/
.venv/
*.egg-info/
build/
dist/
# Generated by the CI commands in .gitea/workflows/ci.yml when run locally (ci coverage lint).
.coverage
coverage.xml
tier-report*.json
