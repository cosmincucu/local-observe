# Copy values into a private environment file on the Linux staging host.
# Image values must be repository@sha256:<64 lowercase hex characters>.
# Version candidates are in components/data/store-signoz/versions.json.
LO_CLICKHOUSE_IMAGE=
LO_ZOOKEEPER_IMAGE=
LO_SIGNOZ_IMAGE=
LO_SIGNOZ_COLLECTOR_IMAGE=
LO_OTEL_IMAGE=
# Absolute path to a separately downloaded and SHA256-verified linux-amd64 binary.
LO_HISTOGRAM_BINARY=
LO_HISTOGRAM_SHA256=
# Every credential is the PATH of a file holding one value, never the value: each manifest mounts
# the file into its container as a Compose secret, so no token sits in a process environment where
# `docker inspect` or /proc/<pid>/environ would show it. Create both files the same way -- printf,
# not echo, because the collector sends the file's bytes verbatim and a trailing newline would land
# inside the Authorization header:
#   umask 077; printf '%s' "$(openssl rand -hex 32)" > /approved/private/ingest-token
# Bearer token accepted by the front door from producers.
LO_INGEST_TOKEN_FILE=
# Store-side credential: the front door -> store collector hop. Generate separately;
# it must not be the same value as the ingest token.
LO_STORE_TOKEN_FILE=
SIGNOZ_JWT_SECRET=
LO_HOST_NAME=nas
# Generate one UUID per installation -- never reuse a committed example value, or every
# installation reports the same identity. Do the same in the inventory declarations you build:
# the Sigma runner will not evaluate a resource it cannot resolve in the index.
# python3 -c "import uuid; print(uuid.uuid4())"
LO_RESOURCE_ID=
# Explicitly authorise the Linux host read mount; do not use a Windows root here.
LO_HOST_ROOT=/
LO_LOG_DIR=
LO_FILESYSTEM_MOUNT_PATTERN=.*
# Ports are published on loopback only. Change if another staging project uses them.
LO_UI_PORT=18081
LO_OTLP_GRPC_PORT=14317
LO_OTLP_HTTP_PORT=14318
LO_INGEST_HEALTH_PORT=13133

# --- Telemetry retention -----------------------------------------------------------------------
# How long the store keeps each signal. SigNoz retention is an API setting, not a file a container
# can read: nothing here reaches the store by itself, and no service applies retention when it
# starts. These are the numbers you intend, and you pass them to the tool that writes them through
# the SigNoz API and then reads them back:
#   python3 components/data/store-signoz/retention.py --url "http://127.0.0.1:$LO_UI_PORT" \
#     --credentials-file /approved/private/signoz-login.json \
#     --traces-days "$LO_RETENTION_TRACES_DAYS" --metrics-days "$LO_RETENTION_METRICS_DAYS" \
#     --logs-days "$LO_RETENTION_LOGS_DAYS"
# Exit 0 already configured | 1 the store differs (add --apply) | 2 could not read it. Until that
# command has run, the store keeps SigNoz's own defaults, not these. Mechanism and verification:
# components/data/store-signoz/CONTRACT.md.
# Left commented on purpose: this template may only carry lines a manifest actually reads (a test
# enforces it), and wiring retention into the bring-up step is the open follow-up retention records.
#
# Disk maths -- measure it, never estimate it. Retention is the ONLY bound on how large the
# clickhouse-data volume grows, and per signal:
#   bytes_kept = ingested_bytes_per_day_per_signal * compression_factor * RETENTION_DAYS
# The volume must hold that SUMMED over traces+metrics+logs, plus the headroom one partition merge
# needs. Both ingested_bytes_per_day_per_signal and compression_factor are properties of YOUR
# workload and the pinned build, so no honest number can ship here: ingest a known volume over a
# known window, read the volume size (`du -s` on the clickhouse-data volume), and re-measure after
# any collector or SigNoz upgrade -- a schema change moves both terms.
#LO_RETENTION_TRACES_DAYS=7
#LO_RETENTION_METRICS_DAYS=30
#LO_RETENTION_LOGS_DAYS=14
