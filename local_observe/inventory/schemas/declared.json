{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:local-observe:schema:v1/declared.json",
  "type": "object", "additionalProperties": false, "required": ["schema_version", "resources"],
  "properties": {
    "schema_version": {"const": 1},
    "resources": {
      "type": "array", "maxItems": 10000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "name", "aliases", "attributes", "relations"],
        "properties": {
          "id": {"$ref": "urn:local-observe:schema:v1/common.json#/$defs/uuid"},
          "kind": {"$ref": "urn:local-observe:schema:v1/common.json#/$defs/kind"},
          "name": {"$ref": "urn:local-observe:schema:v1/common.json#/$defs/text"},
          "aliases": {"$ref": "urn:local-observe:schema:v1/common.json#/$defs/aliases"},
          "attributes": {"$ref": "urn:local-observe:schema:v1/common.json#/$defs/attributes"},
          "credential_refs": {"$ref": "urn:local-observe:schema:v1/common.json#/$defs/credential_refs"},
          "owner": {
            "type": "string", "minLength": 1, "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._@+ -]{0,127}(?![\\s\\S])",
            "description": "The on-call identity the operator's overlay declares for this resource (a team, an account or a mailbox-shaped string), never a hostname and never inferred from one."
          },
          "relations": {
            "type": "array", "maxItems": 1000, "uniqueItems": true,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["type", "target"],
              "properties": {
                "type": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
                "target": {"$ref": "urn:local-observe:schema:v1/common.json#/$defs/uuid"}
              }
            }
          }
        }
      }
    }
  }
}
