{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:local-observe:schema:v1/observed.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "source", "snapshot_id", "observed_at", "status", "complete", "scope", "observations"],
  "properties": {
    "schema_version": {"const": 1},
    "source": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$"},
    "snapshot_id": {"$ref": "urn:local-observe:schema:v1/common.json#/$defs/uuid"},
    "observed_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["ok", "error"]},
    "error_code": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$"},
    "complete": {"type": "boolean"},
    "scope": {"type": "array", "maxItems": 10000, "uniqueItems": true, "items": {"$ref": "urn:local-observe:schema:v1/common.json#/$defs/uuid"}},
    "observations": {
      "type": "array", "maxItems": 10000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["observation_id", "aliases", "attributes", "evidence"],
        "properties": {
          "observation_id": {"$ref": "urn:local-observe:schema:v1/common.json#/$defs/text"},
          "resource_id": {"$ref": "urn:local-observe:schema:v1/common.json#/$defs/uuid"},
          "kind": {"$ref": "urn:local-observe:schema:v1/common.json#/$defs/kind"},
          "name": {"$ref": "urn:local-observe:schema:v1/common.json#/$defs/text"},
          "aliases": {"$ref": "urn:local-observe:schema:v1/common.json#/$defs/aliases"},
          "attributes": {"$ref": "urn:local-observe:schema:v1/common.json#/$defs/attributes"},
          "evidence": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 1024}}
        },
        "anyOf": [{"required": ["resource_id"]}, {"properties": {"aliases": {"minItems": 1}}}]
      }
    }
  },
  "allOf": [{"if": {"properties": {"status": {"const": "error"}}}, "then": {
    "required": ["error_code"], "properties": {"complete": {"const": false}, "observations": {"maxItems": 0}}
  }}]
}
